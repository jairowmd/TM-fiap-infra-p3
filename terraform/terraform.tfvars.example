# Região da AWS onde os recursos serão criados
aws_region = "us-east-1"

# Nome do projeto
project_name = "tm-fiap-p3"

# Ambiente
environment = "dev"

# CIDR principal da VPC
vpc_cidr = "10.0.0.0/16"

# Subnets públicas
public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

# Subnets privadas
private_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]

# Zonas de disponibilidade
availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

# Versão do Kubernetes utilizada pelo EKS
eks_kubernetes_version = "1.34"

# Usuários ou roles que terão acesso administrativo ao EKS.
# Descubra o ARN executando:
# aws sts get-caller-identity --query Arn --output text
#
# Não coloque o ARN real neste arquivo de exemplo.
eks_cluster_admin_principal_arns = [
  "arn:aws:iam::<ACCOUNT_ID>:user/<SEU_USUARIO>"
]

# O usuário padrão dos bancos já é "dbadmin".
# Descomente somente se quiser utilizar outro nome.
# db_username = "dbadmin"

# A senha não deve ser gravada neste arquivo.
# Defina no PowerShell antes do terraform plan/apply:
# $env:TF_VAR_db_password = "uma-senha-forte-com-12-ou-mais-caracteres"